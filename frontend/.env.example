# Copy to frontend/.env.local for local development. NEVER commit .env.local.
# Vite only exposes variables prefixed with VITE_ to client code.

# Base URL of the backend's /api/v1 (F4.1+). No trailing slash.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Demo branding overlay (OnKaizen ownership marks on every screen): a | b | c | off.
# a = sello ejecutivo, b = marca de agua personal (default), c = edición evaluación.
# Fixed at build time; viewers cannot change or remove it from the browser.
VITE_DEMO_BRAND=b
