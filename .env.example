# Metro Intelligence Platform — environment template
# Copy to .env and fill with local values. NEVER commit .env.
# Every value below is a placeholder — no real credentials.

# --- Application ---
APP_ENV=development                # development | staging | production
APP_SECRET_KEY=changeme-generate-a-random-64-char-string
# Product edition: metrology (measurement monitoring only, default) | industrial
# (adds the industrial-quality demo, simulated IIoT signals and AI lab).
APP_EDITION=metrology
# Customer label shown by the industrial demo. Keep the generic value in the
# repo; set the real name only in the deployment environment.
DEMO_CLIENT_LABEL=Cliente demo
# Optional path to a PRIVATE JSON with the customer's historical report summary
# (kept outside the repo). Unset = an illustrative, clearly fictitious example.
DEMO_REPORT_SUMMARY_PATH=
# Optional path to a PRIVATE JSON with the customer's precomputed ML/DL study
# results (IQ-F7 model lab). Unset = an illustrative, clearly fictitious example.
DEMO_MODEL_LAB_PATH=
# Nest that carries the injected defect concentration in the synthetic
# dimensional dataset (1-12). Align it with the customer narrative if needed.
DEMO_CRITICAL_NEST=4
# IQ-F6 exploratory dimensional CSV import (industrial edition). Kept in memory
# only for its owner, never written to the database or object storage. Files
# above the MB cap (or rows above the row cap) are analysed as a sample.
DIMENSIONAL_IMPORT_MAX_ROWS=200000
DIMENSIONAL_IMPORT_MAX_MB=20
DIMENSIONAL_IMPORT_TTL_MINUTES=240
# IQ-F10 (LOCAL USE ONLY): path to the manifest.json of the customer's REAL
# dataset, converted offline with `python -m app.connectors.long_signal_batch`
# into a PRIVATE folder (e.g. demo-private/real-dataset/). Never set it on a
# shared server; it is ignored when APP_ENV=production. Unset = not offered.
DEMO_REAL_DATASET_PATH=
DEMO_REAL_DATASET_MAX_MB=200
DEMO_REAL_DATASET_MAX_PIECES=1000000
# IQ-F19 (LOCAL USE ONLY): path to a PRIVATE JSON with X/Y nominals and
# position tolerances for the REAL dataset (format in
# backend/app/connectors/pin_spec.py), e.g. demo-private/real-dataset/pin-spec.json.
# Unset = the REAL dataset has no X/Y position view.
DEMO_REAL_SPEC_PATH=
# IQ-F21 (LOCAL USE ONLY, plan decisions D14/D15): PRIVATE folder with one
# converted dataset per part (`<slug>/manifest.json` + pieces file, optional
# spec.json / report-summary.json / model-lab.json), offered in the demo's
# part selector as `real-<slug>`. Like DEMO_REAL_DATASET_PATH it is also
# ignored unless every CORS origin is loopback and no hosting-platform
# variable is present (backend/app/core/private_data.py). Never set it on a
# shared server. Unset = only the synthetic data is offered.
DEMO_REAL_DATASETS_DIR=
# How many parts stay loaded in memory at once (LRU, 1-8).
DEMO_REAL_DATASETS_MAX_LOADED=2
# IQ-F30 (plan decision D29), PRIVATE AUTHORIZED HOST ONLY: short reference of the
# customer's WRITTEN authorization to hold its converted data on this host (no
# personal data). Unset everywhere else. It is the only thing that lifts the
# loopback / hosting-platform barriers above (production never serves private data).
DEMO_PRIVATE_HOST_AUTHORIZATION=
# IQ-F30: admin-only HTTPS upload of converted parts (PUT /api/v1/private-datasets/<slug>).
# Only honoured together with DEMO_PRIVATE_HOST_AUTHORIZATION. Default false.
PRIVATE_DATASETS_UPLOAD_ENABLED=false
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 16) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=metro_intelligence
POSTGRES_USER=metro_app
POSTGRES_PASSWORD=changeme-local-only

# --- Auth ---
JWT_SECRET=changeme-generate-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Object storage (MinIO, on-premise) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET_RAW_FILES=raw-measurement-files
MINIO_USE_TLS=false               # true in any non-local environment

# --- Seed data (demo) ---
SEED_DEMO_USER_PASSWORD=changeme-local-only   # shared login password for the demo RBAC users (seed/generators/users.py), hashed with app.core.security.hash_password before storage
# IQ-F30 operator recovery: true = on the next start, set SEED_DEMO_USER_PASSWORD (min 12 chars) on the
# existing demo administrator and reactivate it (audited, never in production). Unset it afterwards.
SEED_DEMO_USER_RESET=false
# End a round of demo credentials: true = on the next start, set SEED_DEMO_USER_PASSWORD (min 12 chars) on
# EVERY user (audited, never in production; nobody is reactivated). Unset it afterwards.
SEED_DEMO_USERS_RESET_ALL=false

# --- Line ingestion (ADR-004; backend/app/ingest/README.md) ---
# The config, spec files and station folders live OUTSIDE the repo.
INGEST_CONFIG_PATH=/ingest-config/ingest.yaml   # in-container path of the ingest YAML
LINE_DATA_DIR=/line-data                        # in-container folder with one subfolder per station
LINE_DATA_HOST_DIR=/srv/line-data               # host folder mounted by docker-compose.ingest.yml
INGEST_CONFIG_HOST_DIR=/srv/ingest-config       # host folder mounted by docker-compose.ingest.yml
# Unattended load (python -m app.cli.load_line_bundle); values are set on the job, never committed.
LINE_BUNDLE_URL=https://files.example.invalid/line-bundle.zip
LINE_INGEST_CONFIG_YAML=                        # full ingest YAML text (see backend/app/ingest/config.example.yaml)
LINE_SPECS_YAML=                                # full specification YAML text (see specs.example.yaml)
LINE_BUNDLE_RUN_IN_API=false                    # true: the API starts the load at startup

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_CONTACT_EMAIL=                # optional: address linked from the "demo access expired" notice on the login page

# --- Observability (optional in demo) ---
LOG_LEVEL=INFO
ENABLE_METRICS=true

# --- VPS editions (IQ-F9, docker-compose.vps.yml, docs/deployment-editions.md) ---
# Only read by docker-compose.vps.yml. Defaults reproduce the current metrology
# deployment, so the metrology .env on the VPS needs none of these.
# INSTANCE=metro                          # prefix of volumes, data network and Traefik routers
# PUBLIC_HOST=metro.example.invalid       # public hostname routed by Traefik
# APP_NETWORK=metro_net_app               # external network shared with Traefik
# APP_ENV_FILE=.env                       # env file loaded into the backend container
# DEMO_PRIVATE_DIR=./infra/demo-private-empty   # host dir mounted read-only at /run/demo-private
#
# Industrial edition: copy this file to .env.industrial ON THE VPS (never in the
# repo) and set at least:
#   APP_EDITION=industrial
#   INSTANCE=metro-industrial
#   PUBLIC_HOST=industrial.example.invalid
#   APP_ENV_FILE=.env.industrial
#   POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD   (its own database volume)
#   MINIO_ACCESS_KEY / MINIO_SECRET_KEY               (its own object storage volume)
#   JWT_SECRET / APP_SECRET_KEY                       (different from metrology)
#   DEMO_PRIVATE_DIR=/home/<user>/metro-private       (outside the repo)
#   DEMO_REPORT_SUMMARY_PATH=/run/demo-private/report-summary.json
#   DEMO_MODEL_LAB_PATH=/run/demo-private/model-lab.json
#   DEMO_CLIENT_LABEL / DEMO_CRITICAL_NEST            (customer values: private brief)
